# ====================================================================
# InternX Frontend Environment Configuration (.env.example)
# ====================================================================

# 1. Google OAuth 2.0 Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# Must add Authorized JavaScript Origins: http://localhost:5173 and http://localhost:3000
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 2. Backend API Gateway URL (Defaults to Spring Cloud Gateway on port 8080)
VITE_API_BASE_URL=http://localhost:8080/api
